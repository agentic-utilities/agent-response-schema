{
  "name": "@aitesthq/agent-response-schema",
  "version": "0.1.1",
  "description": "A Zod-like schema validation and repair library for Agentic frameworks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "npm@11.0.0",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build && npm run test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "llm",
    "json",
    "validation",
    "repair",
    "schema",
    "openai",
    "anthropic"
  ],
  "author": "Your Name",
  "license": "MIT"
}